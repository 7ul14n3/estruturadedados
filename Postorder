class Tree {
    TreeNode raiz;

    Tree() {
    }

    public void inserir(int valor) {
        if (this.raiz == null) {
            this.raiz = new TreeNode(valor);
        } else {
            this.raiz.inserir(valor);
        }

    }

    public void mostrarPosOrdem() {
        if (this.raiz != null) {
            this.raiz.posOrdem();
        }

    }
}


class TreeNode {
    int dado;
    TreeNode filhoEsquerdo;
    TreeNode filhoDireito;

    public TreeNode(int valor) {
        this.dado = valor;
    }

    public void inserir(int valor) {
        if (valor < this.dado) {
            if (this.filhoEsquerdo == null) {
                this.filhoEsquerdo = new TreeNode(valor);
            } else {
                this.filhoEsquerdo.inserir(valor);
            }
        } else if (valor > this.dado) {
            if (this.filhoDireito == null) {
                this.filhoDireito = new TreeNode(valor);
            } else {
                this.filhoDireito.inserir(valor);
            }
        }

    }

    public void posOrdem() {
        if (this.filhoEsquerdo != null) {
            this.filhoEsquerdo.posOrdem();
        }

        if (this.filhoDireito != null) {
            this.filhoDireito.posOrdem();
        }

        System.out.print(this.dado + " ");
    }
}
